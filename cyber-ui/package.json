{
  "name": "@cyber/ui",
  "version": "5.6.0-xd.3",
  "private": false,
  "main": "./dist/cyber-ui.js",
  "module": "./src/index.js",
  "scripts": {
    "gitlog": "node scripts/git-log.js",
    "start": "cyber doc start",
    "build": "cyber doc build",
    "prettier": "prettier --write '**/*.{js,scss,md,json}'",
    "site": "cyber doc site",
    "pub": "yarn gitlog && yarn style && npm publish --registry=http://10.100.3.3:8081/repository/npm-hosted/",
    "cz": "git cz",
    "style": "node scripts/style.js",
    "commit-version": "git add . && git commit -m release：@cyber/ui@%npm_package_version% && git push",
    "pub-with-commit": "yarn gitlog && yarn style && yarn commit-version && npm publish --registry=http://10.100.3.3:8081/repository/npm-hosted/"
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "node scripts/verify-commit-msg.js"
  },
  "lint-staged": {
    "*.{js,scss,md,json}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "types"
  ],
  "dependencies": {
    "@bytemd/plugin-breaks": "^1.21.0",
    "@bytemd/plugin-gfm": "^1.21.0",
    "@bytemd/plugin-highlight": "^1.21.0",
    "@bytemd/plugin-math": "^1.21.0",
    "@uvdream/bytemd-plugin-upload-file": "^0.1.1",
    "ant-design-vue": "^1.7.8",
    "bytemd": "^1.21.0",
    "countup.js": "^2.3.2",
    "css-vars-ponyfill": "^2.4.8",
    "dayjs": "^1.11.6",
    "echarts": "^5.3.3",
    "element-ui": "^2.15.7",
    "highlight.js": "^11.5.1",
    "lodash": "^4.17.21",
    "scroll-into-view-if-needed": "^2.2.29",
    "throttle-debounce": "1.0.1",
    "vue": "^2.6.14",
    "vue-i18n": "8.27.2",
    "vue-js-toggle-button": "^1.3.3",
    "vue-json-viewer": "^2.2.19",
    "vue-router": "3.5.4",
    "vue-template-compiler": "^2.6.14",
    "@vue/composition-api": "^1.7.0"
  },
  "peerDependencies": {
    "@cyber/helper": "*",
    "dayjs": "*",
    "echarts": "^5.3.3",
    "lodash": "^4.17.21",
    "vue": "^2.6.14",
    "vue-i18n": "^8.27.2",
    "vue-router": "^3.5.4"
  },
  "devDependencies": {
    "@cyber/cli": "1.0.0-ui-alpha.4",
    "@cyber/helper": "5.3.5",
    "@types/lodash": "^4.14.184",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.3.0",
    "gitlog": "^4.0.4",
    "lint-staged": "^10.5.4",
    "path": "^0.12.7",
    "prettier": "^2.7.1",
    "sass": "^1.56.1",
    "standard-version": "^9.3.1",
    "ts-node": "^9.1.1",
    "typescript": "^4.2.3",
    "yorkie": "^2.0.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  }
}
