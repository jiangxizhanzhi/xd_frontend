{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "lib": ["es6", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2017",
    "allowJs": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@": ["src"]
    }
  },
  "vueCompilerOptions": {
    "target": 2
  },
  "exclude": [
    "dist",
    "node_modules",
    "test",
    "**/*.tpl",
    "**/template/**/*",
    "**/*.test.ts"
  ]
}
