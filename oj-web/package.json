{
  "name": "cyber-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cyber start",
    "build": "cyber build",
    "translate": "cyber translate",
    "prettier": "prettier --write src/**/*.{js,ts,jsx,tsx,scss,md,json,vue}"
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "node scripts/verifyCommitMsg.js"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,scss,md,json,vue}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cyber/helper": "5.4.1-alpha.1",
    "@cyber/scene": "5.6.0-alpha.7",
    "@cyber/ui": "5.6.0-xd.48",
    "@vue/composition-api": "^1.7.0",
    "axios": "0.26.1",
    "cidr-js": "^2.3.1",
    "crypto-js": "^4.1.1",
    "dragula": "^3.7.2",
    "echarts": "^5.3.3",
    "ip": "^1.1.5",
    "jquery": "^3.6.0",
    "js-cookie": "^2.2.0",
    "lodash": "^4.17.21",
    "moment": "^2.24.0",
    "normalize.css": "8.0.1",
    "properties-loader": "0.0.1",
    "reconnecting-websocket": "^4.4.0",
    "tippy.js": "^6.3.7",
    "vue": "2.6.14",
    "vue-bus": "^1.2.0",
    "vue-cropper": "^0.5.2",
    "vue-i18n": "8.27.2",
    "vuedraggable": "^2.23.2",
    "xss": "^1.0.9"
  },
  "devDependencies": {
    "@cyber/cli": "5.4.0-alpha.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "typescript": "^4.1.3",
    "yorkie": "^2.0.0"
  }
}
