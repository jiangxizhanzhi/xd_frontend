    "@vue/composition-api": "^1.7.0",
    "axios": "0.26.1",
    "codemirror": "^5.41.0",
    "crypto-js": "^4.1.1",
    "dragula": "^3.7.2",
    "echarts": "^5.3.3",
    "echarts-gl": "^1.1.1",
    "element-resize-detector": "^1.1.15",
    "gsap": "^2.0.2",
    "html2canvas": "^1.0.0",
    "jquery": "^3.6.0",
    "js-cookie": "2.2.0",
    "jsplumb": "2.12.6",
